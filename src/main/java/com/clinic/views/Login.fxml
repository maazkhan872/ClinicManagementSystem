<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/8.0.171" 
      xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="com.clinic.controllers.LoginController"
      stylesheets="@../styles/style.css" styleClass="login-container">
    
    <padding>
        <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
    </padding>

    <VBox alignment="CENTER" spacing="10.0" styleClass="header-section">
        <Text text="CLINIC MANAGEMENT SYSTEM" styleClass="title-text"/>
        <Text text="Please login to your account" styleClass="subtitle-text"/>
    </VBox>

    <GridPane vgap="15.0" hgap="10.0" alignment="CENTER">
        <Label text="Username:" GridPane.columnIndex="0" GridPane.rowIndex="0" styleClass="field-label"/>
        <TextField fx:id="txtUsername" promptText="Enter your username" 
                   GridPane.columnIndex="1" GridPane.rowIndex="0" prefWidth="250.0"/>

        <Label text="Password:" GridPane.columnIndex="0" GridPane.rowIndex="1" styleClass="field-label"/>
        <PasswordField fx:id="txtPassword" promptText="Enter your password" 
                       GridPane.columnIndex="1" GridPane.rowIndex="1" prefWidth="250.0"/>
    </GridPane>

    <HBox alignment="CENTER" spacing="15.0">
        <Button fx:id="btnLogin" text="Login" onAction="#handleLogin" 
                prefWidth="120.0" styleClass="btn-primary"/>
        <Button fx:id="btnCancel" text="Cancel" onAction="#handleCancel" 
                prefWidth="120.0" styleClass="btn-secondary"/>
    </HBox>

    <Label fx:id="lblMessage" styleClass="error-text" wrapText="true"/>
    
</VBox>